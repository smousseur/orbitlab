MaterialDef Wrap Lighting {

    MaterialParameters {
        Texture2D DiffuseMap
        Color Ambient
        Color Diffuse
        Boolean UseMaterialColors
        // Width of the soft twilight band on the LIT side of the geometric terminator.
        // The shading is Lambert (N.L) multiplied by a Hermite ramp that reaches 1 at
        // N.L = FallOffFactor, so the shadow boundary stays anchored at N.L = 0 and this
        // value only widens the softened band. It costs light on top of the cosine, so
        // it must stay small: at 0.1 the profile is Lambert to within 5 % everywhere and
        // the visible edge sits at 86 deg from the sub-solar point, at 0.3 it sits at
        // 77 deg, and at 0.8 it collapses to 57 deg — a terminator visibly too early.
        Float FallOffFactor : 0.3

        // Eclipse occulter (docs/eclipses/01-decoupage.md): centre and radius of the body that may
        // block sunlight from this one, in this geometry's world space. Radius 0 (the default) can
        // never intersect anything, so a body with no occulter wired in pays for the per-fragment
        // test but never changes appearance.
        Vector3 OccluderPosition : 0.0 0.0 0.0
        Float OccluderRadius : 0.0
        // Unit vector toward the Sun, in this geometry's world space — deliberately not the
        // g_LightData direction the fragment shader's own lighting loop uses, which JME uploads in
        // view space; the eclipse test needs world space to match vPosWorld without a view-matrix
        // multiply at the call site.
        Vector3 SunDirection : 0.0 0.0 1.0
        // The Sun's angular radius as seen from this body, in radians — needed to turn a hard
        // eclipse boundary into the real penumbra gradient.
        Float SunApparentRadius : 0.0
    }

    Technique {
        LightMode SinglePass

        VertexShader   GLSL150: MatDefs/Light/WrapLighting.vert
        FragmentShader GLSL150: MatDefs/Light/WrapLighting.frag

        WorldParameters {
            WorldMatrix
            WorldViewProjectionMatrix
            WorldViewMatrix
            NormalMatrix
        }

        Defines {
            DIFFUSEMAP : DiffuseMap
            MATERIAL_COLORS : UseMaterialColors
        }
    }
}
